// Generated by scripts/export-bubble-style.sh from NessaDesignSystem. Edit the Swift tokens.
fn bubbleFill(sent: bool): string = sent ? "#0071E3" : "#171717"
fn bubbleGradient(sent: bool): string = sent ? "linear-gradient(180deg, #0071E3, #0058C4)" : "none"
fn bubbleBorderWidth(sent: bool): number = sent ? 0 : 0.5
fn bubbleBorderInk(): string = "#FFFFFF14"
fn quoteFill(sent: bool): string = sent ? "#0071E38C" : "#1717178C"
fn bubbleBackground(): string = "#0A0A0A"
fn bubbleControl(): string = "#262626"
fn bubbleInset(): number = 12
fn bubbleGutter(): number = 70
fn photoWidth(): number = 270
fn photoStackHeight(): number = 240
fn photoStackTilt(): number = 2.5
fn photoRadius(): number = 20
fn gallerySpacing(): number = 4
fn reactionClearance(): number = 42
fn tapbackInk(): string = "#18A4ED"
fn typingCycleMS(): number = 1300
fn typingStepMS(): number = 149.5

style BubbleTextSurface
  padding="12px 16px" border-radius=25
style BubbleInk
  color="#FAFAFA"
style FileBubbleSurface
  gap=8 padding=12 border-radius=18 background-color="#262626"
style QuoteBubbleSurface
  padding=12 border-radius=18
style QuoteInk
  color="#A1A1A1"
style QuoteConnector
  width=44 height=28 margin="0px 12px" border-left="2px solid #A1A1A18C" border-bottom="2px solid #A1A1A18C" border-bottom-left-radius=14
style BubbleMessageSpacing
  gap=8
style BubbleQuoteSpacing
  gap=4
style BubbleReplyCount
  padding="0px 12px" color="#18A4ED"
style BubbleTypingSurface
  gap=5 padding="13px 14px" border-radius=25 background-color="#171717" border="0.5px solid #FFFFFF14"
style TypingTailLarge
  left=-3 bottom=-3 width=12 height=12 border-radius=6 background-color="#171717" border="0.5px solid #FFFFFF14"
style TypingTailSmall
  left=-6 bottom=-9 width=6 height=6 border-radius=3 background-color="#171717" border="0.5px solid #FFFFFF14"
style TypingDot
  width=8 height=8 border-radius=4 background-color="#A1A1A1" opacity=0.35
style TapbackCircle
  top=-34 width=34 height=34 border-radius=17 background-color="#18A4ED"
keyframes typingPulse
  from opacity=0.35 scale=1
  15.5% opacity=1 scale=1.15
  31% opacity=0.35 scale=1
  to opacity=0.35 scale=1
